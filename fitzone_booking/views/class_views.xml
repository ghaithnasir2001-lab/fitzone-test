<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_fitzone_class_list" model="ir.ui.view">
        <field name="name">fitzone.class.list</field>
        <field name="model">fitzone.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="service_id"/>
                <field name="class_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_class_form" model="ir.ui.view">
        <field name="name">fitzone.class.form</field>
        <field name="model">fitzone.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="service_id"/>
                        <field name="class_type"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">fitzone.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_fitzone_class"
        name="Classes"
        parent="menu_fitzone_classes_facilities"
        action="action_fitzone_class"
    />

</odoo>