<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_fitzone_booking_list" model="ir.ui.view">
        <field name="name">fitzone.booking.list</field>
        <field name="model">fitzone.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="name"/>
                <field name="subscriber_id"/>
                <field name="booking_type"/>
                <field name="class_id"/>
                <field name="class_schedule_id"/>
                <field name="swimming_slot_id"/>
                <field name="price"
                       invisible="booking_type != 'swimming' or price &lt;= 0"/>
                <field name="invoice_state"
                       invisible="booking_type != 'swimming' or price &lt;= 0"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_booking_form" model="ir.ui.view">
        <field name="name">fitzone.booking.form</field>
        <field name="model">fitzone.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">

                <header>
                    <button
                        name="action_create_invoice"
                        string="Create Invoice"
                        type="object"
                        class="btn-primary"
                        invisible="booking_type != 'swimming' or price &lt;= 0 or invoice_id"
                    />
                    <button
                        name="action_view_invoice"
                        string="View Invoice"
                        type="object"
                        invisible="booking_type != 'swimming' or price &lt;= 0 or not invoice_id"
                    />
                </header>

                <sheet>
                    <group>

                        <field name="name"/>
                        <field name="booking_type"/>
                        <field name="subscriber_id"/>

                        <field
                            name="class_id"
                            invisible="booking_type != 'class'"
                            required="booking_type == 'class'"
                        />

                        <field
                            name="class_schedule_id"
                            invisible="booking_type != 'class'"
                            required="booking_type == 'class'"
                            domain="[('class_id', '=', class_id)]"
                        />

                        <field
                            name="swimming_slot_id"
                            invisible="booking_type != 'swimming'"
                            required="booking_type == 'swimming'"
                        />

                        <field
                            name="physiotherapy_start_datetime"
                            invisible="booking_type != 'physiotherapy'"
                            required="booking_type == 'physiotherapy'"
                        />

                        <field
                            name="physiotherapy_end_datetime"
                            invisible="booking_type != 'physiotherapy'"
                            required="booking_type == 'physiotherapy'"
                        />

                        <field name="currency_id" invisible="1"/>

                        <field
                            name="price"
                            readonly="1"
                            invisible="booking_type != 'swimming' or price &lt;= 0"
                        />

                        <field
                            name="invoice_id"
                            readonly="1"
                            invisible="booking_type != 'swimming' or price &lt;= 0"
                        />

                        <field
                            name="invoice_state"
                            readonly="1"
                            invisible="booking_type != 'swimming' or price &lt;= 0"
                        />

                        <field name="status"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">fitzone.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_fitzone_booking"
        name="Bookings"
        parent="menu_fitzone_root"
        action="action_fitzone_booking"
        sequence="50"
    />

</odoo>