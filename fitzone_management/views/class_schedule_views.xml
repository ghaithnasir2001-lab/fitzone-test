<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_fitzone_class_schedule_list" model="ir.ui.view">
        <field name="name">fitzone.class.schedule.list</field>
        <field name="model">fitzone.class.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="class_id"/>
                <field name="facility_id"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_class_schedule_form" model="ir.ui.view">
        <field name="name">fitzone.class.schedule.form</field>
        <field name="model">fitzone.class.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="class_id"/>
                        <field name="facility_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_class_schedule" model="ir.actions.act_window">
        <field name="name">Class Schedules</field>
        <field name="res_model">fitzone.class.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_fitzone_class_schedule"
        name="Class Schedules"
        parent="menu_fitzone_classes_facilities"
        action="action_fitzone_class_schedule"
    />

</odoo>