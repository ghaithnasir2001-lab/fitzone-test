<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- Trainer List View -->
    <!-- ========================================================= -->

    <record id="view_fitzone_trainer_list" model="ir.ui.view">
        <field name="name">fitzone.trainer.list</field>
        <field name="model">fitzone.trainer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Trainer Form View -->
    <!-- ========================================================= -->

    <record id="view_fitzone_trainer_form" model="ir.ui.view">
        <field name="name">fitzone.trainer.form</field>
        <field name="model">fitzone.trainer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialization"/>
                        </group>

                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Weekly recurring availability -->
                        <page string="Working Schedule">

                            <field name="working_schedule_ids">

                                <list editable="bottom">
                                    <field name="day_of_week"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="active"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Trainer Booking List View -->
    <!-- Used for the actual Trainer Schedule -->
    <!-- ========================================================= -->

    <record id="view_fitzone_trainer_schedule_list" model="ir.ui.view">
        <field name="name">fitzone.trainer.schedule.list</field>
        <field name="model">fitzone.trainer.booking</field>
        <field name="arch" type="xml">
            <list>

                <field name="trainer_id"/>
                <field name="subscriber_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state"/>

            </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Trainer Booking Calendar View -->
    <!-- ========================================================= -->

    <record id="view_fitzone_trainer_schedule_calendar" model="ir.ui.view">
        <field name="name">fitzone.trainer.schedule.calendar</field>
        <field name="model">fitzone.trainer.booking</field>
        <field name="arch" type="xml">

            <calendar
                string="Trainer Schedule"
                date_start="start_datetime"
                date_stop="end_datetime"
                color="trainer_id"
            >
                <field name="trainer_id"/>
                <field name="subscriber_id"/>
                <field name="state"/>
            </calendar>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Trainer Booking List -->
    <!-- ========================================================= -->

    <record id="view_fitzone_trainer_booking_list" model="ir.ui.view">
        <field name="name">fitzone.trainer.booking.list</field>
        <field name="model">fitzone.trainer.booking</field>
        <field name="arch" type="xml">
            <list>

                <field name="trainer_id"/>
                <field name="subscriber_id"/>
                <field name="membership_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state"/>

            </list>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Trainer Booking Form -->
    <!-- ========================================================= -->

    <record id="view_fitzone_trainer_booking_form" model="ir.ui.view">
        <field name="name">fitzone.trainer.booking.form</field>
        <field name="model">fitzone.trainer.booking</field>
        <field name="arch" type="xml">

            <form>

                <header>

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-secondary"
                        invisible="state == 'cancelled'"
                    />

                    <field name="state" widget="statusbar"/>

                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="trainer_id"/>
                            <field name="subscriber_id"/>
                            <field name="membership_id"/>
                        </group>

                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </group>

                    </group>

                    <group>
                        <field name="notes"/>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Trainer Action -->
    <!-- ========================================================= -->

    <record id="action_fitzone_trainers" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">fitzone.trainer</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- Trainer Schedule Action -->
    <!-- Actual booked trainer schedule -->
    <!-- ========================================================= -->

    <record id="action_fitzone_trainer_schedules" model="ir.actions.act_window">
        <field name="name">Trainer Schedules</field>
        <field name="res_model">fitzone.trainer.booking</field>
        <field name="view_mode">calendar,list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- Trainer Booking Action -->
    <!-- ========================================================= -->

    <record id="action_fitzone_trainer_bookings" model="ir.actions.act_window">
        <field name="name">Trainer Bookings</field>
        <field name="res_model">fitzone.trainer.booking</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- Trainer Management Menu -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_fitzone_trainer_management"
        name="Trainer Management"
        parent="menu_fitzone_root"
        sequence="30"
    />


    <!-- Trainers -->

    <menuitem
        id="menu_fitzone_trainers"
        name="Trainers"
        parent="menu_fitzone_trainer_management"
        action="action_fitzone_trainers"
        sequence="10"
    />


    <!-- Actual Trainer Schedules -->

    <menuitem
        id="menu_fitzone_trainer_schedules"
        name="Schedules"
        parent="menu_fitzone_trainer_management"
        action="action_fitzone_trainer_schedules"
        sequence="20"
    />


    <!-- Trainer Bookings -->

    <menuitem
        id="menu_fitzone_trainer_bookings"
        name="Bookings"
        parent="menu_fitzone_trainer_management"
        action="action_fitzone_trainer_bookings"
        sequence="30"
    />

</odoo>