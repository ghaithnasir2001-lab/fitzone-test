<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_fitzone_membership_installment_list" model="ir.ui.view">
        <field name="name">fitzone.membership.installment.list</field>
        <field name="model">fitzone.membership.installment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="installment_number"/>
                <field name="amount"/>
                <field name="amount_paid"/>
                <field name="amount_due"/>
                <field name="due_date"/>
                <field name="payment_method"/>
                <field name="payment_status"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_membership_installment_form" model="ir.ui.view">
        <field name="name">fitzone.membership.installment.form</field>
        <field name="model">fitzone.membership.installment</field>
        <field name="arch" type="xml">
            <form string="Membership Installment">
                <header>
                    <button
                        name="action_create_invoice"
                        type="object"
                        string="Create Official Invoice"
                        class="btn-primary"
                        invisible="invoice_id"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="subscription_id"/>
                            <field name="installment_number"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="payment_method"/>
                            <field name="payment_status"/>
                            <field name="invoice_id"/>
                            <field name="invoice_state"/>
                        </group>
                    </group>
                    <group string="Payment Summary">
                        <field name="amount_paid"/>
                        <field name="amount_due"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_membership_installments" model="ir.actions.act_window">
        <field name="name">Membership Installments</field>
        <field name="res_model">fitzone.membership.installment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_fitzone_membership_installments"
        name="Membership Installments"
        parent="menu_fitzone_membership_root"
        action="action_fitzone_membership_installments"
        sequence="30"
    />
</odoo>