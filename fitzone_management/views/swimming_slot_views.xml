<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_fitzone_swimming_slot_list" model="ir.ui.view">
        <field name="name">fitzone.swimming.slot.list</field>
        <field name="model">fitzone.swimming.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="facility_id"/>
                <field name="slot_type"/>
                <field name="trainer_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="price"/>
                <field name="created_by"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_swimming_slot_form" model="ir.ui.view">
        <field name="name">fitzone.swimming.slot.form</field>
        <field name="model">fitzone.swimming.slot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>

                        <field name="name" invisible="1"/>

                        <field
                            name="facility_id"
                            domain="[
                                ('facility_type', '=', 'swimming'),
                                ('booking_method', '=', 'swimming_slot'),
                                ('state', '=', 'available')
                            ]"
                        />

                        <field name="slot_type"/>
                        <field
                            name="trainer_id"
                            invisible="slot_type == 'free'"
                            required="slot_type in ['group', 'private']"
                        />
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                        <field name="price"/>
                        <field name="created_by"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_swimming_slot" model="ir.actions.act_window">
        <field name="name">Swimming Slots</field>
        <field name="res_model">fitzone.swimming.slot</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_fitzone_swimming_slot"
        name="Swimming Slots"
        parent="menu_fitzone_classes_facilities"
        action="action_fitzone_swimming_slot"
    />

</odoo>