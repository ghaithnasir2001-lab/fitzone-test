<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Membership Subscription Sequence -->
    <record id="seq_fitzone_membership_subscription" model="ir.sequence">
        <field name="name">FitZone Membership Subscription</field>
        <field name="code">fitzone.membership.subscription</field>
        <field name="prefix">SUB/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
        <!-- Membership Barcode Sequence -->
    <record id="seq_fitzone_membership_barcode" model="ir.sequence">
        <field name="name">FitZone Membership Barcode</field>
        <field name="code">fitzone.membership.barcode</field>
        <field name="prefix"></field>
        <field name="padding">12</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Membership Freeze Sequence -->
    <record id="seq_fitzone_membership_freeze" model="ir.sequence">
        <field name="name">FitZone Membership Freeze</field>
        <field name="code">fitzone.membership.freeze</field>
        <field name="prefix">FRZ/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>