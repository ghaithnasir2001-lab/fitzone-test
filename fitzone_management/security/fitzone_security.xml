<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_fitzone_health_staff" model="res.groups">
        <field name="name">FitZone Health Staff</field>
    </record>

    <record id="group_fitzone_nutritionist" model="res.groups">
        <field name="name">FitZone Nutritionist</field>
        <field name="implied_ids"
               eval="[(4, ref('fitzone_management.group_fitzone_health_staff'))]"/>
    </record>

    <record id="group_fitzone_physiotherapist" model="res.groups">
        <field name="name">FitZone Physiotherapist</field>
        <field name="implied_ids"
               eval="[(4, ref('fitzone_management.group_fitzone_health_staff'))]"/>
    </record>

    <record id="group_fitzone_management" model="res.groups">
        <field name="name">FitZone Management</field>
        <field name="implied_ids"
               eval="[(4, ref('fitzone_management.group_fitzone_health_staff'))]"/>
    </record>
</odoo>
